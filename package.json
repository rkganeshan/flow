{
  "name": "flow",
  "private": true,
  "packageManager": "npm@10.5.0",
  "scripts": {
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:status": "node scripts/db/migrate.mjs --status",
    "db:reset": "node scripts/db/migrate.mjs --reset",
    "db:new": "node scripts/db/new-migration.mjs",
    "test:e2e:backend": "node scripts/dev/smoke-backend.mjs",
    "test:e2e:schedule": "node scripts/dev/smoke-schedule.mjs",
    "api:dev": "tsx watch services/api/src/server.ts",
    "api:start": "node services/api/dist/cli.js",
    "api:build": "tsc -p services/api/tsconfig.json",
    "dev:seed:tenant": "node scripts/dev/seed-tenant.mjs",
    "dev:seed:e2e": "node scripts/dev/seed-e2e-notify.mjs",
    "engine:dev": "tsx watch services/engine/src/cli.ts",
    "worker:dev": "tsx watch services/worker/src/cli.ts",
    "engine:build": "tsc -p services/engine/tsconfig.json",
    "worker:build": "tsc -p services/worker/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bullmq": "^5.16.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.29.1",
    "ioredis": "^5.4.1",
    "pg": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "toad-cache": "3.3.0"
  }
}
