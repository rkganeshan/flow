# Flow local environment variables (Docker-first)

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=flow
POSTGRES_USER=flow
POSTGRES_PASSWORD=flow
DATABASE_URL=postgres://flow:flow@localhost:55432/flow

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MailHog (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_UI_URL=http://localhost:8025
