# Flow local environment variables (Docker-first)

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=flow
POSTGRES_USER=flow
POSTGRES_PASSWORD=flow
DATABASE_URL=postgresql://flow:flow@localhost:55432/flow

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MailHog (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_UI_URL=http://localhost:8025

# http_request node safety (MVP)
# Comma-separated allowlist of hostnames. Leave empty to allow all (not recommended).
HTTP_NODE_ALLOWED_HOSTS=
HTTP_NODE_TIMEOUT_MS=5000
HTTP_NODE_MAX_RESPONSE_BYTES=100000
